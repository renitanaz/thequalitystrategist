{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeakAndPack CI review findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "issue": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["sev1", "sev2", "sev3", "unclear"]
          },
          "matches_known_pattern": {
            "type": ["string", "null"],
            "description": "A catalog bug ID this resembles (e.g. BUG-007), or null if this looks like a genuinely new issue."
          }
        },
        "required": ["file", "line", "issue", "severity"]
      }
    }
  },
  "required": ["findings"]
}
